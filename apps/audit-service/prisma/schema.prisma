datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorName String   @default("System")
  action    String
  resource  String
  details   String?
  ipAddress String?
  result    String   @default("success")
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
