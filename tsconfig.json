{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@medcare/contracts": ["libs/contracts/src/index"],
      "@medcare/contracts/*": ["libs/contracts/src/*"],
      "@medcare/broker": ["libs/broker/src/index"],
      "@medcare/broker/*": ["libs/broker/src/*"],
      "@medcare/kafka": ["libs/kafka/src/index"],
      "@medcare/kafka/*": ["libs/kafka/src/*"],
      "@medcare/auth": ["libs/auth/src/index"],
      "@medcare/auth/*": ["libs/auth/src/*"],
      "@medcare/logger": ["libs/logger/src/index"],
      "@medcare/logger/*": ["libs/logger/src/*"],
      "@medcare/common": ["libs/common/src/index"],
      "@medcare/common/*": ["libs/common/src/*"],
      "@medcare/shared": ["libs/shared/src/index"],
      "@medcare/shared/*": ["libs/shared/src/*"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
