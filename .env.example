# ==========================================
# MedCare Platform Environment Configuration (.env.example)
# ==========================================
PORT=3000
NODE_ENV=development

# ------------------------------------------
# PostgreSQL Database Engine Credentials
# ------------------------------------------
POSTGRES_USER=medcare
POSTGRES_PASSWORD=medcare_secure_pass
POSTGRES_DB=medcare_db
DB_PORT=5435

# ------------------------------------------
# Microservice Database-per-Service URLs
# ------------------------------------------
# Auth Service (User accounts, OAuth, Permissions)
DATABASE_URL_AUTH="postgresql://medcare:medcare_secure_pass@localhost:5435/auth_db?schema=public"

# Doctor Service (Doctor profiles, weekly schedules, notes, payouts)
DATABASE_URL_DOCTOR="postgresql://medcare:medcare_secure_pass@localhost:5435/doctor_db?schema=public"

# Patient Service (Patient profiles, medical records, digital prescriptions)
DATABASE_URL_PATIENT="postgresql://medcare:medcare_secure_pass@localhost:5435/patient_db?schema=public"

# Appointment Service (Bookings, 6-step check-in wizard, live token queue)
DATABASE_URL_APPOINTMENT="postgresql://medcare:medcare_secure_pass@localhost:5435/appointment_db?schema=public"

# Clinic Service (Clinics, rooms, medical staff rosters)
DATABASE_URL_CLINIC="postgresql://medcare:medcare_secure_pass@localhost:5435/clinic_db?schema=public"

# Billing Service (Invoices, transactions, payment gateways, refunds)
DATABASE_URL_BILLING="postgresql://medcare:medcare_secure_pass@localhost:5435/billing_db?schema=public"

# Notification Service (Broadcasts, SMS/Email queue, in-app alerts)
DATABASE_URL_NOTIFICATION="postgresql://medcare:medcare_secure_pass@localhost:5435/notification_db?schema=public"

# Audit Service (Immutable security and activity audit logs)
DATABASE_URL_AUDIT="postgresql://medcare:medcare_secure_pass@localhost:5435/audit_db?schema=public"

# Chat Service (Conversations, direct consultation threads, attachments)
DATABASE_URL_CHAT="postgresql://medcare:medcare_secure_pass@localhost:5435/chat_db?schema=public"

# Default fallback URL
DATABASE_URL="postgresql://medcare:medcare_secure_pass@localhost:5435/medcare_db?schema=public"

# ------------------------------------------
# Redis Message Broker & Cache
# ------------------------------------------
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380"

# ------------------------------------------
# JWT Security & Tokens
# ------------------------------------------
JWT_SECRET="medcare_enterprise_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="1d"

# ------------------------------------------
# OAuth Providers (Google SSO)
# ------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id_here"

# ------------------------------------------
# Mail & SMTP Server (Mailpit: localhost:1025 or Production SMTP)
# ------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="MedCare Health Platform <noreply@medcare.local>"

# ------------------------------------------
# pgAdmin (Database GUI - http://localhost:5050)
# ------------------------------------------
PGADMIN_DEFAULT_EMAIL="admin@medcare.com"
PGADMIN_DEFAULT_PASSWORD="admin_secure_password_2026"
