model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model SystemHealthLog {
  id             String   @id @default(cuid())
  service        String
  status         String
  latencyMs      Float
  memoryUsageMb  Float
  details        String?
  createdAt      DateTime @default(now())

  @@index([service])
  @@index([createdAt])
  @@map("system_health_logs")
}
