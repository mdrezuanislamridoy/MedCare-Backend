enum StaffRole {
  RECEPTIONIST
  NURSE
  SUPPORT_STAFF
  LAB_TECHNICIAN
  PHARMACIST
  SECURITY
  CLEANER
}

enum StaffShiftStatus {
  ON_DUTY
  ON_BREAK
  OFF_DUTY
  ON_LEAVE
}

model ClinicStaff {
  id                 String           @id @default(cuid())
  clinicId           String
  userId             String?
  name               String
  email              String?
  phone              String?
  role               StaffRole        @default(RECEPTIONIST)
  shiftStatus        StaffShiftStatus @default(OFF_DUTY)
  shiftStart         String?
  shiftEnd           String?
  assignedDepartment String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  clinic             Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user               User?            @relation(fields: [userId], references: [id])

  @@map("clinic_staff")
}
