model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  result    String   @default("success")
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
