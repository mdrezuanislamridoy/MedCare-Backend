enum UserRole {
  SUPER_ADMIN
  ADMIN
  PATIENT
  DOCTOR
  CLINIC_MANAGER
  RECEPTIONIST
  SUPPORT_STAFF
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String?
  name            String?
  role            UserRole          @default(PATIENT)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  providerAccounts ProviderAccount[]

  @@map("users")
}
