enum ComplaintStatus {
  NEW
  UNDER_INVESTIGATION
  RESPONDED
  RESOLVED
  ESCALATED
}

enum ComplaintCategory {
  DOCTOR_CONDUCT
  BILLING_ERROR
  APPOINTMENT_ERROR
  STAFF_CONDUCT
  WAIT_TIME
  OTHER
}

model Complaint {
  id                String            @id @default(cuid())
  complaintNumber   String            @unique
  patientId         String
  patient           PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relatedDoctorId   String?
  relatedDoctor     DoctorProfile?    @relation(fields: [relatedDoctorId], references: [id])
  category          ComplaintCategory @default(OTHER)
  priority          TicketPriority    @default(MEDIUM)
  status            ComplaintStatus   @default(NEW)
  title             String
  description       String
  adminNotes        String?
  resolutionSummary String?
  assignedStaffId   String?
  assignedStaff     User?             @relation("StaffAssignedComplaints", fields: [assignedStaffId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, priority])
  @@index([relatedDoctorId])
  @@index([patientId])
  @@map("complaints")
}
